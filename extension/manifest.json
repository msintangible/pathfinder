{
  "manifest_version": 3,
  "name": "Pathfinder",
  "version": "0.1.0",
  "description": "AI-powered job application agent. Detects job pages and assists with tailored applications.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["storage", "sidePanel", "scripting", "activeTab", "offscreen"],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://pathfinder-x4lb.onrender.com/*"
  ],

  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Pathfinder"
  },

  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/dom.js",
        "src/content/jsonld.js",
        "src/content/detect.js",
        "src/content/scrape.js",
        "src/content/observe.js",
        "src/content/index.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
