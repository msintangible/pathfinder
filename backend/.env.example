# Copy to .env and fill in real values. Never commit .env itself.

# App
DEBUG=false
# development | production — SSRF dev-mode allowance and the JWT
# default-secret guard both key off this. Set to "production" for any
# real deployment.
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pathfinder?ssl=disable
# Only read by docker-compose to configure the local Postgres container —
# unused by the app itself once DATABASE_URL is set.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pathfinder
POSTGRES_PORT=5432

# Redis — declared but not currently used by any code path.
REDIS_URL=redis://localhost:6379/0

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required before ENVIRONMENT=production (app refuses to boot with the default).
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ANONYMOUS_TOKEN_EXPIRE_DAYS=365

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# AI providers — GEMINI_API_KEY is the only one any code path actually uses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us-central1

# Object storage — declared but not currently used by any code path.
S3_BUCKET=pathfinder-documents
S3_REGION=us-east-1

# Local resume PDF storage. Relative paths resolve against the backend/
# package root, not the process CWD. In production, point this at the
# mounted persistent disk with an absolute path.
RESUME_STORAGE_PATH=./storage/resumes

# Rate limits (requests per minute, per client IP)
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_GENERATION=10
